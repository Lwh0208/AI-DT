# ============================================
# 智能回复助手 环境变量配置模板
# 使用方式：复制本文件为 .env 并填入实际值
# ============================================

# LLM API 地址（内网推理服务）
LLM_API_URL=http://10.127.23.252:44937/v1/chat/completions

# LLM 模型名称
LLM_MODEL=qwen36-35b-a3b

# LLM 认证 Token（如果服务需要）
# LLM_AUTH_TOKEN=your_token_here

# LLM 请求超时时间（秒）
LLM_TIMEOUT_SECONDS=120

# 严格 OpenAI 兼容模式：true 时默认只发送 model/messages；
# 调用方显式设置输出上限时额外发送 max_tokens
LLM_STRICT_OPENAI_COMPAT=true

# 缺失年份补全默认值
DEFAULT_YEAR=2026

# 滑动窗口上下文条数
CONTEXT_WINDOW_SIZE=50

# 初始化画像时注入 LLM 的历史聊天最大字符数；0 表示不限制
PROFILE_INIT_MAX_INPUT_CHARS=0

# 初始化画像时允许 LLM 输出的最大 token 数
PROFILE_INIT_MAX_TOKENS=16384

# 初始化画像仅使用该日期之前的历史聊天记录
PROFILE_INIT_CUTOFF=2026-03-01

# Dream 模式画像/记忆更新时允许 LLM 输出的最大 token 数
DREAM_MAX_TOKENS=16384
